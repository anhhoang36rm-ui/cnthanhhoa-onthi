# Sao chép file này thành .env (hoặc khai báo trực tiếp trên nền tảng hosting) và điền giá trị thật.
# KHÔNG commit file .env thật lên Git.

# Chuỗi bí mật để ký cookie phiên - đặt cố định, dài, ngẫu nhiên (vd: python3 -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Đặt =1 nếu chạy sau reverse proxy có HTTPS (Nginx/Caddy/Render/Railway...) để cookie tự nhận đúng HTTPS
TRUST_PROXY=1

# Danh sách email được coi là admin, phân tách bằng dấu phẩy (mặc định "admin")
ADMIN_EMAILS=admin

# Cấu hình gửi email tự động khi duyệt tài khoản (tuỳ chọn - có thể bỏ trống nếu không dùng)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true

# Bật debug khi phát triển ở máy cá nhân - PHẢI để 0 hoặc bỏ trống khi public lên internet
FLASK_DEBUG=0
